PORT=4000
DATABASE_URL=./data/demo.sqlite
FRONTEND_ORIGIN=http://localhost:3000
# Per provider call, in milliseconds
PROVIDER_TIMEOUT_MS=30000

# OpenAI Decisions (POST /v1/decisions) uses OPENAI_API_KEY below. gpt-6-luna is the
# only supported model per the guide; check with `bun run spike:decisions`.
OPENAI_DECISIONS_MODEL=gpt-6-luna

OPENAI_API_KEY=
# Model that answers the three comparison questions (the baseline judge)
OPENAI_BASELINE_MODEL=gpt-4
# Real model IDs behind the Model Router tiers; also used to draft candidate replies
OPENAI_FAST_MODEL=gpt-4-turbo
OPENAI_BALANCED_MODEL=gpt-4
OPENAI_CAPABLE_MODEL=gpt-4
